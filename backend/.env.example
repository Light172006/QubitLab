QUBITLAB_DATABASE_URL=postgresql+asyncpg://qubitlab:qubitlab@localhost:5432/qubitlab
QUBITLAB_REDIS_URL=redis://localhost:6379/0
QUBITLAB_SECRET_KEY=your-secret-key-change-in-production
QUBITLAB_GEMINI_API_KEY=your-gemini-api-key
QUBITLAB_GEMINI_MODEL=gemini-2.5-flash
QUBITLAB_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
QUBITLAB_SIMULATION_TIMEOUT=30
QUBITLAB_MAX_QUBITS=12
QUBITLAB_DEFAULT_SHOTS=1024
